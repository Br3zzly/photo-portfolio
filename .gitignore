# Generated while publishing, then deleted once it is in the bucket. Nothing
# here is a copy of anything: the pyramid is rebuilt from the original, and the
# original lives in your own library, not in this repository.
tiles/
thumbs/
.staging/
.manifest.tmp.json

# Python
__pycache__/
*.py[cod]

# OS clutter
.DS_Store
Thumbs.db
desktop.ini

# The old staging folder. Publishing no longer uses it -- photographs are
# picked from wherever you keep them -- but your originals are still sitting
# in it until you move them, and they must never be committed.
photos/
archive/
